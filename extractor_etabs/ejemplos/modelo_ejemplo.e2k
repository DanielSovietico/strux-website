$ LOAD PATTERNS
  LOADPATTERN  "CM"  TYPE  "Dead"  SELFWEIGHT  0
  LOADPATTERN  "CV"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN  "CVa"  TYPE  "Reduce Live"  SELFWEIGHT  0
  LOADPATTERN  "Sx"  TYPE  "Seismic"  SELFWEIGHT  0
  LOADPATTERN  "Sy"  TYPE  "Seismic"  SELFWEIGHT  0

$ LOAD COMBINATIONS
  COMBO  "1.3CM+1.5CV"  TYPE "Linear Add"  NOTE "Gravitacional"
  COMBO  "1.1(CM+CVa+Sx)"  TYPE "Linear Add"  NOTE "Sismo X"
  COMBO  "1.1(CM+CVa-Sx)"  TYPE "Linear Add"  NOTE "Sismo X"
  COMBO  "1.1(CM+CVa+Sy)"  TYPE "Linear Add"  NOTE "Sismo Y"
